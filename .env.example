# ---- Providers -------------------------------------------------------------------------------
# LLM_PROVIDER: openai | ollama | extractive (extractive = offline baseline with NO LLM, for plumbing tests only)
LLM_PROVIDER=extractive
LLM_MODEL=gpt-4o-mini
# EMBEDDING_PROVIDER: openai | huggingface | hash (hash = offline lexical embeddings for development only)
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
# Required only when a provider above is 'openai'. Never commit your real key.
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
TEMPERATURE=0
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# ---- Chunking (see evaluation/chunk_experiment.py) --------------------------------------------
CHUNK_STRATEGY=structure
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---- Retrieval --------------------------------------------------------------------------------
# similarity | mmr | threshold | hybrid | hybrid_rerank
RETRIEVAL_STRATEGY=hybrid_rerank
RETRIEVAL_K=4
FETCH_K=20
# Relevance gate. Calibrated for the 'hash' embeddings only. RECALIBRATE after changing embedding model:
#   python -m evaluation.retrieval_experiments   (read threshold_calibration.recommended_threshold)
SCORE_THRESHOLD=0.29
HYBRID_WEIGHT_DENSE=0.5
# none | lexical | cross_encoder (cross_encoder needs: pip install sentence-transformers, plus a model download)
RERANKER=lexical
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MAX_CONTEXT_CHUNKS=4
MAX_CONTEXT_CHARS=6000
HISTORY_WINDOW_TURNS=4

# ---- Storage ----------------------------------------------------------------------------------
VECTOR_STORE_PATH=data/vector_store
COLLECTION_NAME=pearlz_kb
LOG_LEVEL=INFO

# ---- Application ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/app.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# First admin account is created at start-up when both are set
ADMIN_EMAIL=
ADMIN_PASSWORD=
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_S=60
MAX_UPLOAD_MB=10
SUPPORT_EMAIL=support@pearlzhome.example
# Optional tracing (LangChain reads these standard variables)
LANGSMITH_API_KEY=
